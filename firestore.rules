rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to read the routine, teachers, and notices
    match /{document=**} {
      allow read: if true;
    }

    // Only allow writes if the user is authenticated (Admin)
    // In a production app, we would check for a specific admin UID or role
    // For this remix, we assume any authenticated user is an admin or we check PIN in UI
    match /routine_overrides/{item} {
      allow write: if request.auth != null;
    }

    match /teachers/{teacher} {
      allow write: if request.auth != null;
    }

    match /notices/current_announcement {
      allow write: if request.auth != null;
    }
  }
}
